{
  "name": "valaxy-addon-giscus",
  "type": "module",
  "version": "0.2.0",
  "description": "Giscus comment system addon for Valaxy — GitHub Discussions powered comments",
  "keywords": [
    "valaxy",
    "addon",
    "giscus",
    "comment"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNskarin/valaxy-addon-giscus.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./types/index.ts",
      "default": "./types/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "default": "./client/index.ts"
    },
    "./components/*": "./components/*",
    "./*": "./*"
  },
  "main": "index.ts",
  "types": "index.d.ts",
  "files": [
    "index.ts",
    "index.d.ts",
    "node",
    "client",
    "components",
    "types"
  ],
  "peerDependencies": {
    "valaxy": ">=1.0.0-rc.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1"
  }
}
